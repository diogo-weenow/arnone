<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Chamar_Opt_Out_SOL</name>
        <label>Registrar opt-out SOL</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <actionName>SOLOptOutInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leadId</name>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SOLOptOutInvocable</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>CLICKUP-9418 — Aciona SOLOptOutInvocable quando uma tarefa de contato SOL (SOL_Tipo_Tarefa__c = &quot;Contato&quot;, WhoId preenchido) é concluída com Resultado do contato = &quot;Opt-out&quot;. Sem bloqueio por horário/dia. A desqualificação do Lead (Status &quot;Desqualificado&quot; + motivo &quot;Opt-out&quot;), o cancelamento das tarefas pendentes e o bloqueio de novas tarefas ficam no Apex (bulk, FOR UPDATE, atômico). Não altera campos aqui. Não modifica outros Flows.</description>
    <environments>Default</environments>
    <interviewLabel>SOL_Opt_Out {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SOL_Opt_Out</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Chamar_Opt_Out_SOL</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  TEXT({!$Record.Status}) = &apos;Completed&apos;,
  TEXT({!$Record.SOL_Resultado_Contato__c}) = &apos;Opt-out&apos;,
  TEXT({!$Record.SOL_Tipo_Tarefa__c}) = &apos;Contato&apos;,
  NOT(ISBLANK({!$Record.WhoId}))
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
