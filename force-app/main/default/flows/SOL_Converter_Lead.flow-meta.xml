    <description>CLICKUP-9350 — ação guiada que converte o lead da Arnone Soluções em Conta, Contato e Oportunidade. O gatilho de negócio é a entrega da procuração assinada; ART 360 dispensa o documento mas exige a liberação do atendente. A tela conduz duas decisões que não podem ser tomadas em silêncio: reaproveitar ou não a Conta encontrada pelo CNPJ, e reaproveitar ou não o Contato dela. A regra vive em SOL_ConverterLead e SOL_PrepararConversao, onde fica versionada e coberta por teste.</description>
    <environments>Default</environments>
    <interviewLabel>SOL_Converter_Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Converter Lead — Arnone Soluções</label>
    <processType>Flow</processType>
    <recordUpdates>
        <description>Deixa registrado no lead quem dispensou a procuração, em vez de a dispensa existir só na cabeça de quem clicou.</description>
        <name>Marcar_Apto</name>
        <label>Registrar a liberação do ART 360</label>
        <locationX>302</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Tem_Conta</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SOL_Apto_Conversao__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
