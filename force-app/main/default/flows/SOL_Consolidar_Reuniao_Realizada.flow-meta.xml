<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Lead_SOL_Sem_Data</name>
        <label>Lead SOL sem a data consolidada?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Não — nada a fazer</defaultConnectorLabel>
        <rules>
            <name>Consolidar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.SOL_Data_Reuniao_Realizada__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Consolidar_Data</targetReference>
            </connector>
            <label>Consolidar a primeira data</label>
        </rules>
    </decisions>
    <description>CLICKUP-9419 — Quando uma Task de &quot;Reunião comercial&quot; é concluída (Status = &quot;Completed&quot;, SOL_Resultado_Reuniao__c = &quot;Realizada&quot;, CompletedDateTime preenchido, WhoId apontando para Lead), copia o CompletedDateTime para Lead.SOL_Data_Reuniao_Realizada__c — mas SÓ se o campo ainda estiver vazio (preserva a PRIMEIRA reunião realizada; reprocessamentos e reuniões posteriores não sobrescrevem). Consolida a evidência da reunião no Lead porque as Tasks ficam indisponíveis para consulta durante Database.convertLead. Não altera a Task. Bulk-safe (Get Records + Update do Flow são bulkificados).</description>
    <environments>Default</environments>
    <interviewLabel>SOL_Consolidar_Reuniao_Realizada {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SOL_Consolidar_Reuniao_Realizada</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Buscar o Lead do WhoId</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lead_SOL_Sem_Data</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Consolidar_Data</name>
        <label>Gravar a data no Lead</label>
        <locationX>50</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SOL_Data_Reuniao_Realizada__c</field>
            <value>
                <elementReference>$Record.CompletedDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  TEXT({!$Record.SOL_Tipo_Tarefa__c}) = &apos;Reunião comercial&apos;,
  TEXT({!$Record.Status}) = &apos;Completed&apos;,
  TEXT({!$Record.SOL_Resultado_Reuniao__c}) = &apos;Realizada&apos;,
  NOT(ISBLANK({!$Record.CompletedDateTime})),
  NOT(ISBLANK({!$Record.WhoId}))
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
