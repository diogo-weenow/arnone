<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Normalizar_CNPJ</name>
        <label>Normalizar CNPJ</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>$Record.SOL_CNPJ_Normalizado__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fCNPJNormalizado</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Upload enriquecimento Lemit — popula Lead.SOL_CNPJ_Normalizado__c com o CNPJ__c somente dígitos (remove ponto, barra, hífen e espaço), em before-save (sem DML extra) na criação e quando o CNPJ muda. É a chave de casamento do enriquecimento. Roda para qualquer Record Type; para Lead sem CNPJ grava vazio. NÃO altera CNPJ__c nem qualquer outro campo, e é independente de Lead_AfterCreate_DefinirUnidade e SOL_Distribuir_Lead.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCNPJNormalizado</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK({!$Record.CNPJ__c}), &apos;&apos;, {!$Record.CNPJ__c}), &apos;.&apos;, &apos;&apos;), &apos;/&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;), &apos; &apos;, &apos;&apos;)</expression>
    </formulas>
    <interviewLabel>Lead_BeforeSave_Normalizar_CNPJ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_BeforeSave_Normalizar_CNPJ</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Normalizar_CNPJ</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.CNPJ__c}))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
