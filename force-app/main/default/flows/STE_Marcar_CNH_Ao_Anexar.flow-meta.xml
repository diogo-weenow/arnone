                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Marcar_CNH</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <description>Marca a CNH como enviada quando um arquivo é anexado ao lead do Instituto STech, inclusive pelo botão Files da tela. Sem isso, só o anexo vindo da conversa do WhatsApp contava, e a regra de conversão barrava candidato que tinha documento.</description>
    <environments>Default</environments>
