    <assignments>
        <description>Este lead não é da Arnone Soluções. Em vez de só avisar, o estado fica registrado no dado — quem olhar o lead depois vê que a etapa foi dispensada, não esquecida.</description>
        <name>Marcar_Nao_Aplicavel</name>
        <label>Marcar como não aplicável</label>
        <locationX>440</locationX>
        <locationY>396</locationY>
        <assignmentItems>
            <assignToReference>Buscar_Lead.SOL_Status_Procuracao__c</assignToReference>
