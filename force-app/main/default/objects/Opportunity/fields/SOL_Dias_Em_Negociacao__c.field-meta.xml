<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOL_Dias_Em_Negociacao__c</fullName>
    <description>Há quantos dias a Oportunidade está na etapa de Negociação. Fica em branco fora dela.</description>
    <externalId>false</externalId>
    <formula>IF(
  ISPICKVAL(StageName, &apos;Negociação&apos;),
  FLOOR(NOW() - SOL_Data_Entrada_Negociacao__c),
  NULL
)</formula>
    <label>Dias em Negociação</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
