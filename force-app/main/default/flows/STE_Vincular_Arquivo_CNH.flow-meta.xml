<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Arquivo_Encontrado</name>
        <label>Arquivo encontrado na sessão?</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Não encontrado</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Arquivo_Da_Sessao</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Buscar_Vinculo_Existente</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <decisions>
        <name>Ja_Vinculado</name>
        <label>Arquivo já vinculado ao Lead?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Criar_Vinculo_Arquivo</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não, vincular agora</defaultConnectorLabel>
        <rules>
            <name>Ja_Existe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Vinculo_Existente</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Já existe</label>
        </rules>
    </decisions>
    <description>Vincula aos Files do Lead o arquivo de CNH que o candidato enviou pelo Assistente Stech Telecom. O bot anexa o arquivo apenas à MessagingSession; este flow copia o vínculo para o Lead. Roda em scheduled path (2 minutos após a criação/atualização do Lead) para dar tempo da plataforma processar o upload, e como scheduled path executa como Automated Process — o mesmo usuário dono do arquivo — não depende de permissão adicional de Content para o usuário de integração do bot.</description>
    <environments>Default</environments>
    <interviewLabel>STE_Vincular_Arquivo_CNH {!$Flow.CurrentDateTime}</interviewLabel>
    <label>STE_Vincular_Arquivo_CNH</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Criar_Vinculo_Arquivo</name>
        <label>Vincular arquivo ao Lead</label>
        <locationX>50</locationX>
        <locationY>708</locationY>
        <inputAssignments>
            <field>ContentDocumentId</field>
            <value>
                <elementReference>Buscar_Arquivo_Da_Sessao.ContentDocumentId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LinkedEntityId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShareType</field>
            <value>
                <stringValue>V</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Visibility</field>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </inputAssignments>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Buscar_Arquivo_Da_Sessao</name>
        <label>Buscar arquivo vinculado à sessão</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Arquivo_Encontrado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.STE_MessagingSession_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Buscar_Vinculo_Existente</name>
        <label>Verificar se já está vinculado ao Lead</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Ja_Vinculado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContentDocumentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Buscar_Arquivo_Da_Sessao.ContentDocumentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  {!$Record.RecordType.DeveloperName} = &quot;STE&quot;,
  NOT(ISBLANK({!$Record.STE_MessagingSession_Id__c}))
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Um_Minuto_Depois</name>
            <connector>
                <targetReference>Buscar_Arquivo_Da_Sessao</targetReference>
            </connector>
            <label>1 minuto depois</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
