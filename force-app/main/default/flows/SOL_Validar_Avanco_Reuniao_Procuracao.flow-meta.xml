        <locationX>590</locationX>
        <locationY>620</locationY>
        <customErrorMessages>
            <errorMessage>A procuração ainda não foi recebida. É preciso Status da procuração = &quot;Recebida&quot; e a Data do recebimento da procuração preenchida para avançar para Apto para Conversão ou converter o Lead.</errorMessage>
