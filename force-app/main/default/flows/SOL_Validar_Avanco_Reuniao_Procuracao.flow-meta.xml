        <locationY>500</locationY>
        <customErrorMessages>
            <errorMessage>A reunião comercial ainda não foi realizada. É preciso uma tarefa de Reunião comercial concluída, com Resultado da reunião = &quot;Realizada&quot; e data/hora de conclusão preenchida, antes de avançar a etapa.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Erro_Solicitacao</name>
