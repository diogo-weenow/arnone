        <rules>
            <name>Candidato_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Resolver_Classificacao.tipoRegistro</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Vincular_Lead_Sessao</targetReference>
            </connector>
            <label>Lead localizado</label>
        </rules>
        <rules>
            <name>Candidato_Classificado_Sem_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Resolver_Classificacao.classificacao</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Atualizar_Classificacao_Sessao</targetReference>
            </connector>
            <label>Contato localizado</label>
        </rules>
    </decisions>
