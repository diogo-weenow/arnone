<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Usar_Contato_Da_Conta</name>
        <label>Usar o contato da conta</label>
        <locationX>302</locationX>
        <locationY>614</locationY>
        <assignmentItems>
            <assignToReference>varContatoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Buscar_Contato_Da_Conta.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Espelhar_No_Contato</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Usar_Contato_Do_Papel</name>
        <label>Usar o contato do papel</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <assignmentItems>
            <assignToReference>varContatoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Buscar_Papel_Do_Contato.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Espelhar_No_Contato</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Tem_Contato_Na_Conta</name>
        <label>A conta tem contato?</label>
        <locationX>302</locationX>
        <locationY>494</locationY>
        <defaultConnectorLabel>Não tem</defaultConnectorLabel>
        <rules>
            <name>Tem_Contato</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Contato_Da_Conta.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Usar_Contato_Da_Conta</targetReference>
            </connector>
            <label>Tem</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Papel_De_Contato</name>
        <label>A oportunidade tem contato no papel?</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Buscar_Contato_Da_Conta</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não tem</defaultConnectorLabel>
        <rules>
            <name>Tem_Papel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Papel_Do_Contato.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Usar_Contato_Do_Papel</targetReference>
            </connector>
            <label>Tem</label>
        </rules>
    </decisions>
    <description>Copia para o Contato os dados da turma e do consentimento que ficam na Oportunidade. A Jornada Pré-Curso roda no Data Cloud em cima do Contato (é dele que sai o Indivíduo e o e-mail), então o Contato precisa ser o espelho. Quem manda continua sendo a Oportunidade: ninguém edita esses campos no Contato. Acha o contato pelo papel na oportunidade; se não houver papel, cai no contato da conta.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDataTurmaTexto</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.STE_Data_Inicio_Turma__c}),
  &quot;&quot;,
  RIGHT(&quot;0&quot; &amp; TEXT(DAY({!$Record.STE_Data_Inicio_Turma__c})), 2) &amp; &quot;/&quot; &amp;
  RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!$Record.STE_Data_Inicio_Turma__c})), 2) &amp; &quot;/&quot; &amp;
  TEXT(YEAR({!$Record.STE_Data_Inicio_Turma__c}))
)</expression>
    </formulas>
    <interviewLabel>STE Espelhar Turma No Contato {!$Flow.CurrentDateTime}</interviewLabel>
    <label>STE Espelhar Turma No Contato</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Buscar_Contato_Da_Conta</name>
        <label>Buscar o contato da conta</label>
        <locationX>302</locationX>
        <locationY>374</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tem_Contato_Na_Conta</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Buscar_Papel_Do_Contato</name>
        <label>Buscar o contato pelo papel na oportunidade</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tem_Papel_De_Contato</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContactId</queriedFields>
        <sortField>IsPrimary</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Espelhar_No_Contato</name>
        <label>Espelhar os dados no contato</label>
        <locationX>50</locationX>
        <locationY>494</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varContatoId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>STE_Aceite_Comunicacoes__c</field>
            <value>
                <elementReference>$Record.STE_Aceite_Comunicacoes__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Certificado_Emitido__c</field>
            <value>
                <elementReference>$Record.STE_Certificado_Emitido__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Comparecimento__c</field>
            <value>
                <elementReference>$Record.STE_Comparecimento__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Curso_Concluido__c</field>
            <value>
                <elementReference>$Record.STE_Curso_Concluido__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Data_Inicio_Turma__c</field>
            <value>
                <elementReference>$Record.STE_Data_Inicio_Turma__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Data_Turma_Texto__c</field>
            <value>
                <elementReference>fDataTurmaTexto</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Horario_Turma__c</field>
            <value>
                <elementReference>$Record.STE_Horario_Turma__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Oportunidade_Jornada__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Opt_Out__c</field>
            <value>
                <elementReference>$Record.STE_Opt_Out__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Turma__c</field>
            <value>
                <elementReference>$Record.STE_Turma__c</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Buscar_Papel_Do_Contato</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>STE_Data_Inicio_Turma__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varContatoId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
