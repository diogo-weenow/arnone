<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Normalizar_CNPJ</name>
        <label>Normalizar CNPJ</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>$Record.CNPJ_Normalizado__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fCNPJNormalizado</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>CLICKUP-12115 — popula Account.CNPJ_Normalizado__c com o CNPJ__c sem ponto, barra, hífen e espaço e em maiúsculas (aceita o CNPJ alfanumérico), em before-save (sem DML extra), na criação, quando o CNPJ muda ou quando o normalizado está vazio. Mesma regra do Lead_BeforeSave_Normalizar_CNPJ. CNPJ vazio grava vazio. É a chave única de Conta no Grupo (campo Unique + duplicate rule Conta_CNPJ_Unico). NÃO altera CNPJ__c nem qualquer outro campo.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCNPJNormalizado</name>
        <dataType>String</dataType>
        <expression>UPPER(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK({!$Record.CNPJ__c}), &apos;&apos;, {!$Record.CNPJ__c}), &apos;.&apos;, &apos;&apos;), &apos;/&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;), &apos; &apos;, &apos;&apos;))</expression>
    </formulas>
    <interviewLabel>Account_BeforeSave_Normalizar_CNPJ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_BeforeSave_Normalizar_CNPJ</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Normalizar_CNPJ</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.CNPJ__c}), ISBLANK({!$Record.CNPJ_Normalizado__c}))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
