<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Chamar_Reatribuicao_SOL</name>
        <label>Chamar reatribuição SOL por falta de contato</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <actionName>SOLReatribuicaoContatoInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leadId</name>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SOLReatribuicaoContatoInvocable</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>CLICKUP-9400 — Aciona SOLReatribuicaoContatoInvocable quando uma Task com contato (WhoId preenchido) é concluída com Resultado do contato = "Sem sucesso". A Invocable descarta WhoId que não seja Lead; toda a contagem de tentativas, concorrência e reatribuição fica no Apex. Não altera campos aqui. Não modifica outros Flows nem a Assignment Rule.</description>
    <environments>Default</environments>
    <interviewLabel>SOL_Reatribuir_Por_Falta_Contato {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SOL_Reatribuir_Por_Falta_Contato</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Chamar_Reatribuicao_SOL</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  TEXT({!$Record.Status}) = &apos;Completed&apos;,
  TEXT({!$Record.SOL_Resultado_Contato__c}) = &apos;Sem sucesso&apos;,
  NOT(ISBLANK({!$Record.WhoId}))
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
