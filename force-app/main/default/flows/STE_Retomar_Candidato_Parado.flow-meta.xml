            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Marcar_Etapa_Cobrada</name>
        <label>Registrar que esta pergunta já foi cobrada</label>
        <locationX>176</locationX>
        <locationY>864</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>STE_Etapa_Notificada__c</field>
            <value>
                <elementReference>Buscar_Lead.STE_Etapa_Bot__c</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>AND(
  {!$Record.RecordType.DeveloperName} = &quot;STE&quot;,
  NOT(ISBLANK({!$Record.STE_Retomada_1_Em__c})),
  TEXT({!$Record.STE_Classificacao_Fila__c}) = &quot;Fria&quot;,
  TEXT({!$Record.STE_Etapa_Bot__c}) &lt;&gt; &quot;Concluído&quot;
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Uma_Hora_Util</name>
            <connector>
                <targetReference>Buscar_Lead</targetReference>
            </connector>
            <label>1 hora útil após a última resposta</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>STE_Retomada_1_Em__c</recordField>
