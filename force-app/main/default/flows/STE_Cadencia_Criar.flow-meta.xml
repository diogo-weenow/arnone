    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>US 10 — cria as 4 tarefas da cadência de lembrete pré-aula quando, na etapa Pré-Matrícula, a turma e a data de início são confirmadas. Datas relativas ao início da turma; lembrete às 12h GMT. Marca STE_Cadencia_Criada para não duplicar. After-save (cria registros filhos).</description>
    <environments>Default</environments>
    <formulas>
        <name>due1</name>
        <dataType>Date</dataType>
        <expression>{!$Record.STE_Data_Inicio_Turma__c} - 7</expression>
    </formulas>
    <formulas>
        <name>due2</name>
        <dataType>Date</dataType>
        <expression>{!$Record.STE_Data_Inicio_Turma__c} - 2</expression>
    </formulas>
    <formulas>
        <name>due3</name>
        <dataType>Date</dataType>
        <expression>{!$Record.STE_Data_Inicio_Turma__c} - 1</expression>
    </formulas>
    <formulas>
        <name>rem1</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.STE_Data_Inicio_Turma__c} - 7) &amp; &quot; 12:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>rem2</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.STE_Data_Inicio_Turma__c} - 2) &amp; &quot; 12:00:00&quot;)</expression>
