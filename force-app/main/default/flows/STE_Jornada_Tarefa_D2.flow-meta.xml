<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Faltam_Dois_Dias</name>
        <label>Faltam dois dias para a turma começar?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Sim_Faltam_Dois_Dias</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fEhDiaDaTarefa</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Criar_Tarefa_De_Confirmacao</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <description>Jornada Pré-Curso: dois dias antes do início da turma, abre uma tarefa de ligação para o dono da oportunidade confirmar a presença do candidato no primeiro dia. Roda todo dia de manhã e só pega quem tem data de turma, aceite de comunicações e não fez opt-out. O recorte do dia fica na decisão, não no filtro de entrada, porque o filtro de entrada não aceita data calculada.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDataDaTarefa</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fDescricaoDaTarefa</name>
        <dataType>String</dataType>
        <expression>&quot;Ligar para o candidato e confirmar a presença no primeiro dia de aula.&quot; &amp;
BR() &amp; BR() &amp;
&quot;Início da turma: &quot; &amp; TEXT({!$Record.STE_Data_Inicio_Turma__c}) &amp; BR() &amp;
&quot;Polo: &quot; &amp; TEXT({!$Record.STE_Turma__c}) &amp; BR() &amp;
&quot;Horário: &quot; &amp; IF(ISBLANK({!$Record.STE_Horario_Turma__c}), &quot;a confirmar&quot;, {!$Record.STE_Horario_Turma__c}) &amp; BR() &amp; BR() &amp;
&quot;Se o candidato avisar que não vai, registre em Comparecimento na oportunidade.&quot;</expression>
    </formulas>
    <formulas>
        <name>fEhDiaDaTarefa</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.STE_Data_Inicio_Turma__c} = TODAY() + 2</expression>
    </formulas>
    <interviewLabel>STE Jornada Tarefa D2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>STE Jornada Pré-Curso — Tarefa D-2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Criar_Tarefa_De_Confirmacao</name>
        <label>Abrir a tarefa de ligação</label>
        <locationX>50</locationX>
        <locationY>254</locationY>
        <connector>
            <targetReference>Marcar_Etapa_Na_Oportunidade</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fDataDaTarefa</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fDescricaoDaTarefa</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Ligar para confirmar presença no 1º dia</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TaskSubtype</field>
            <value>
                <stringValue>Call</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Marcar_Etapa_Na_Oportunidade</name>
        <label>Marcar a etapa na oportunidade</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>STE_Jornada_PreCurso_Em__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>STE_Jornada_PreCurso_Etapa__c</field>
            <value>
                <stringValue>D-2 Tarefa de confirmação</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Faltam_Dois_Dias</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>STE_Data_Inicio_Turma__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>STE_Aceite_Comunicacoes__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>STE_Opt_Out__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-23</startDate>
            <startTime>11:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
