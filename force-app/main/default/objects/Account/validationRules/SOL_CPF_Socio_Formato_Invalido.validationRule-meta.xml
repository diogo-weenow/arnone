<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOL_CPF_Socio_Formato_Invalido</fullName>
    <active>true</active>
    <description>Arnone Soluções: exige o CPF do sócio majoritário no formato 000.000.000-00 quando preenchido.</description>
    <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;SOL&quot;,
  NOT(ISBLANK(SOL_CPF_Socio_Majoritario__c)),
  NOT(REGEX(SOL_CPF_Socio_Majoritario__c, &quot;\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}&quot;))
)</errorConditionFormula>
    <errorDisplayField>SOL_CPF_Socio_Majoritario__c</errorDisplayField>
    <errorMessage>CPF do sócio majoritário deve estar no formato 000.000.000-00.</errorMessage>
</ValidationRule>
