<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOL_Contato_Avaliado__c</fullName>
    <description>CLICKUP-9428. Vale 1 quando SOL_Resultado_Normalizado__c e Sucesso ou Sem sucesso. E o denominador da taxa: canceladas e pendentes ficam de fora por definicao.</description>
    <externalId>false</externalId>
    <formula>IF( OR( SOL_Resultado_Normalizado__c = &quot;Sucesso&quot;, SOL_Resultado_Normalizado__c = &quot;Sem sucesso&quot; ), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Contato avaliado (1/0)</label>
    <precision>18</precision>
    <scale>0</scale>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
