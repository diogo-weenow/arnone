<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOL_Dias_Sem_Atualizacao__c</fullName>
    <description>Há quantos dias o lead não recebe nenhuma edição. Conta a partir da última modificação, seja de campo, de dono ou de status.</description>
    <externalId>false</externalId>
    <formula>FLOOR(NOW() - LastModifiedDate)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Dias sem atualização</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
